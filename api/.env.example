# Copy this file to `.env` and adjust the values.
# Every variable here is read once at startup and the process refuses to start
# when one is missing or malformed. Nothing secret belongs in this file.

NODE_ENV=development
PORT=3000

# Arcjet key for rate limiting and bot defence on public routes.
ARCJET_KEY=
# Set to development when running Arcjet locally, so it does not warn on localhost.
ARCJET_ENV=development

# Better Auth: signing secret (32+ chars) and the origin the browser reaches the
# API on. In development this is the web origin because the Vite proxy keeps auth
# first party. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# The first admin, created by the idempotent seed script (npm run db:seed).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional: Resend mails verification links in production only.
RESEND_API_KEY=

# Neon Postgres connection strings. The pooled URL serves the running API; the
# unpooled (direct) URL is used only for schema migrations, so drizzle-kit can
# use session-level operations. The process refuses to start without DATABASE_URL.
DATABASE_URL=postgresql://user:password@host-with-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
